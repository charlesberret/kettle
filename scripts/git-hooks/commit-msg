#!/usr/bin/env bash
# Kettle family — commit-msg hook (macOS bash 3.2–compatible).
# See docs/reference/commit-conventions.md. Install: ./scripts/install-git-hooks.sh
set -euo pipefail

MSG_FILE="${1:-}"
if [[ -z "$MSG_FILE" || ! -f "$MSG_FILE" ]]; then
  echo "commit-msg: missing message file" >&2
  exit 1
fi

# First non-comment, non-empty line = subject
SUBJECT=""
BODY_STARTED=0
PREV_WAS_SUBJECT=0
while IFS= read -r line || [[ -n "$line" ]]; do
  # strip CR
  line="${line%$'\r'}"
  case "$line" in
    \#*) continue ;;
  esac
  # trim trailing space
  line="${line%"${line##*[![:space:]]}"}"

  if [[ -z "$SUBJECT" ]]; then
    if [[ -z "$line" ]]; then
      continue
    fi
    SUBJECT="$line"
    PREV_WAS_SUBJECT=1
    continue
  fi

  # After subject: require blank line before any body content
  if [[ $PREV_WAS_SUBJECT -eq 1 ]]; then
    if [[ -z "$line" ]]; then
      PREV_WAS_SUBJECT=0
      BODY_STARTED=1
      continue
    else
      echo "commit-msg: separate subject and body with a blank line" >&2
      exit 1
    fi
  fi
done < "$MSG_FILE"

if [[ -z "$SUBJECT" ]]; then
  echo "commit-msg: empty commit message" >&2
  exit 1
fi

case "$SUBJECT" in
  Merge\ *|Revert\ *) exit 0 ;;
esac

len=${#SUBJECT}
if [[ $len -gt 100 ]]; then
  echo "commit-msg: subject too long ($len > 100 chars)" >&2
  echo "  → $SUBJECT" >&2
  exit 1
fi
if [[ $len -lt 3 ]]; then
  echo "commit-msg: subject too short" >&2
  exit 1
fi

# Optional: type(scope)?: subject
case "$SUBJECT" in
  feat:*|fix:*|docs:*|chore:*|refactor:*|test:*|ci:*|style:*|feat\(*|fix\(*|docs\(*|chore\(*|refactor\(*|test\(*|ci\(*|style\(*)
    if [[ "$SUBJECT" == *. ]]; then
      echo "commit-msg: omit trailing period on subject (conventional style)" >&2
      echo "  → $SUBJECT" >&2
      exit 1
    fi
    # must have content after "type: " or "type(scope): "
    if [[ "$SUBJECT" =~ ^(feat|fix|docs|chore|refactor|test|ci|style)(\([a-zA-Z0-9._-]+\))?\!?:\ *$ ]]; then
      echo "commit-msg: type prefix needs a subject after colon" >&2
      exit 1
    fi
    ;;
esac

exit 0
